# Salin ke .env lalu sesuaikan: cp .env.example .env

# Token Hugging Face (read). Kosongkan bila repo model publik.
HF_TOKEN=

# Model generator yang di-serve vLLM. Ganti ke repo SFT untuk memakai model SFT murni:
# LLM_MODEL=Fepriyadi/Qwen2.5-3B-Instruct-Alpaca-ID-SFT
LLM_MODEL=Fepriyadi/Qwen2.5-3B-Instruct-Alpaca-ID-GRPO

# Porsi VRAM untuk vLLM (bobot ~6.2 GB + KV cache). Sisanya dipakai bge-m3 + reranker di service app.
# T4 16 GB: 0.6 | L4 24 GB: 0.5
VLLM_GPU_MEMORY_UTILIZATION=0.6
VLLM_IMAGE_TAG=v0.11.0

# Threshold skor reranker Top-1 untuk fallback DuckDuckGo. Cek dengan: python -m legal_rag.calibrate
RERANK_THRESHOLD=0.05
